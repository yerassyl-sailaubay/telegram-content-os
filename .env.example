# ============================================================
# telegram-content-os — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to source control.
# ============================================================

# ---- Supabase -----------------------------------------------
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon (public) key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — server-side only, keep secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Postgres connection string (used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_POOL_MAX=10

# ---- Stripe --------------------------------------------------
# Secret key — server-side only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Publishable key — safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook signing secret from Stripe dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for subscription tiers (from Stripe dashboard → Products)
STRIPE_PLUS_PRICE_ID=price_your_plus_price_id_here
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here

# ---- OpenRouter (AI) [DEPRECATED — replaced by Google Gemini] ---
# OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# ---- Google AI (Gemini) --------------------------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Telegram -----------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Secret for validating incoming webhook requests (random hex string, 1-256 chars)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# ---- LinkedIn OAuth -----------------------------------------
# From LinkedIn Developer Portal → Your App → Auth
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# ---- Twitter / X OAuth --------------------------------------
# From developer.x.com → Your App → Keys and Tokens
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here

# ---- Inngest (background jobs) ------------------------------
# From Inngest dashboard → Settings → Signing Keys
INNGEST_SIGNING_KEY=signkey-your_inngest_signing_key_here

# From Inngest dashboard → Settings → Event Keys
INNGEST_EVENT_KEY=your_inngest_event_key_here

# ---- Encryption ---------------------------------------------
# 32-byte hex string for AES-256-GCM encryption of OAuth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ---- App ----------------------------------------------------
# Base URL of this application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional SEO / contact metadata
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
SUPPORT_EMAIL=
