# ============================================================
# telegram-content-os — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to source control.
# ============================================================

# ---- Supabase -----------------------------------------------
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon (public) key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — server-side only, keep secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Direct Postgres connection string (used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_POOL_MAX=10

# ---- Stripe --------------------------------------------------
# Secret key — server-side only
STRIPE_SECRET_KEY=sk_test_<key>

# Publishable key — safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>

# Webhook signing secret from Stripe dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_<secret>

# ---- Google Gemini (AI) -------------------------------------
# API key from Google AI Studio (aistudio.google.com) — server-side only
GEMINI_API_KEY=<api-key>

# ---- Telegram -----------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=<bot-token>

# Secret for validating incoming webhook requests
TELEGRAM_WEBHOOK_SECRET=<random-hex-string>

# ---- LinkedIn OAuth -----------------------------------------
LINKEDIN_CLIENT_ID=<client-id>
LINKEDIN_CLIENT_SECRET=<client-secret>

# ---- Twitter / X OAuth --------------------------------------
TWITTER_CLIENT_ID=<client-id>
TWITTER_CLIENT_SECRET=<client-secret>

# ---- Inngest (background jobs) ------------------------------
INNGEST_SIGNING_KEY=signkey-<key>
INNGEST_EVENT_KEY=<event-key>

# ---- App ----------------------------------------------------
# Base URL of this application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional SEO / contact metadata
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
SUPPORT_EMAIL=
